    private function get_all_meta_data($post_id) {
        $all_meta = get_post_meta($post_id);
        $processed_meta = array();
        
        foreach ($all_meta as $key => $value) {
            if (is_array($value) && count($value) === 1) {
                $processed_meta[$key] = $value[0];
            } else {
                $processed_meta[$key] = $value;
            }
        }
        
        // 특별 옵션과 접근성 기능은 배열로 처리
        $processed_meta['special_options'] = get_post_meta($post_id, 'special_options', false);
        $processed_meta['accessibility_features'] = get_post_meta($post_id, 'accessibility_features', false);
        
        return $processed_meta;
    }
    
    public function save_enhanced_meta_data($post_id) {
        if (!isset($_POST['sungsuya_enhanced_metabox_nonce']) || 
            !wp_verify_nonce($_POST['sungsuya_enhanced_metabox_nonce'], 'sungsuya_enhanced_metabox')) {
            return;
        }
        
        if (defined('DOING_AUTOSAVE') && DOING_AUTOSAVE) {
            return;
        }
        
        if (!current_user_can('edit_post', $post_id)) {
            return;
        }
        
        $meta_fields = array(
            // 기본 정보
            'store_name' => 'sanitize_text_field',
            'store_description' => 'sanitize_textarea_field',
            'category' => 'sanitize_text_field',
            
            // 위치 정보
            'address' => 'sanitize_text_field',
            'latitude' => 'sanitize_text_field',
            'longitude' => 'sanitize_text_field',
            'district' => 'sanitize_text_field',
            'nearest_subway_station' => 'sanitize_text_field',
            'walking_time_from_station' => 'sanitize_text_field',
            
            // 운영 정보
            'start_date' => 'sanitize_text_field',
            'end_date' => 'sanitize_text_field',
            'opening_hours' => 'sanitize_text_field',
            'operation_status' => 'sanitize_text_field',
            'special_notes' => 'sanitize_textarea_field',
            'reservation_required' => 'sanitize_text_field',
            
            // 소셜 & 연락처
            'phone_number' => 'sanitize_text_field',
            'email' => 'sanitize_email',
            'instagram_url' => 'esc_url_raw',
            'facebook_url' => 'esc_url_raw',
            'youtube_url' => 'esc_url_raw',
            'website_url' => 'esc_url_raw',
            'hashtags' => 'sanitize_text_field',
            'booking_url' => 'esc_url_raw',
            'event_url' => 'esc_url_raw',
            
            // 🚇 지하철역 자동 입력 정보
            'subway_exit_info' => 'sanitize_text_field',  // JSON 형태로 저장
            
            // 투어 최적화
            'recommended_visit_duration' => 'sanitize_text_field',
            'best_visit_time' => 'sanitize_text_field',
            'crowd_level_weekday' => 'sanitize_text_field',
            'crowd_level_weekend' => 'sanitize_text_field',
            'nearby_recommendations' => 'sanitize_textarea_field',
            'combination_tips' => 'sanitize_textarea_field'
        );
        
        foreach ($meta_fields as $field => $sanitize_function) {
            if (isset($_POST[$field])) {
                $value = call_user_func($sanitize_function, $_POST[$field]);
                update_post_meta($post_id, $field, $value);
            }
        }
        
        // 배열 필드 처리
        $array_fields = array('special_options', 'accessibility_features');
        
        foreach ($array_fields as $field) {
            delete_post_meta($post_id, $field);
            if (isset($_POST[$field]) && is_array($_POST[$field])) {
                foreach ($_POST[$field] as $value) {
                    add_post_meta($post_id, $field, sanitize_text_field($value));
                }
            }
        }
        
        // 투어 호환성 점수 자동 계산 및 저장
        $this->calculate_and_save_tour_compatibility_score($post_id);
    }
    
    private function calculate_and_save_tour_compatibility_score($post_id) {
        $required_fields = array('store_name', 'address', 'category', 'latitude', 'longitude');
        $score = 0;
        
        foreach ($required_fields as $field) {
            $value = get_post_meta($post_id, $field, true);
            if (!empty($value)) {
                $score += 20;
            }
        }
        
        // 보너스 점수
        $bonus_fields = array('store_description', 'nearest_subway_station');
        foreach ($bonus_fields as $field) {
            $value = get_post_meta($post_id, $field, true);
            if (!empty($value)) {
                $score += 10;
            }
        }
        
        update_post_meta($post_id, 'tour_compatibility_score', min(100, $score));
    }
    
    public function ajax_search_address() {
        // 디버깅을 위한 로그
        error_log('🔍 [팝업스토어] AJAX 주소 검색 호출됨');
        error_log('🔍 [팝업스토어] POST 데이터: ' . print_r($_POST, true));
        
        check_ajax_referer('sungsuya_enhanced_admin', 'nonce');
        
        $query = sanitize_text_field($_POST['query'] ?? '');
        error_log('🔍 [팝업스토어] 검색 쿼리: ' . $query);
        
        if (empty($query)) {
            error_log('❌ [팝업스토어] 검색어 없음');
            wp_send_json_error('검색어가 없습니다.');
        }
        
        // Places 시스템의 지오코딩 매니저 사용
        global $sungsuya_geocoding_manager;
        if (!$sungsuya_geocoding_manager && class_exists('Sungsuya_Geocoding_Manager')) {
            $sungsuya_geocoding_manager = new Sungsuya_Geocoding_Manager();
        }
        
        if (!$sungsuya_geocoding_manager) {
            error_log('❌ [팝업스토어] 지오코딩 매니저 사용 불가');
            wp_send_json_error('주소 검색 기능을 사용할 수 없습니다.');
        }
        
        $result = $sungsuya_geocoding_manager->search_address($query, 10);
        
        error_log('📍 [팝업스토어] 지오코딩 결과: ' . wp_json_encode($result));
        
        if ($result['success'] && !empty($result['results'])) {
            // 첫 번째 결과를 반환 (기존 코드 호환성)
            $first_result = $result['results'][0];
            
            // 기존 형식에 맞춰 데이터 변환
            $response_data = array(
                'roadAddress' => $first_result['roadAddress'],
                'jibunAddress' => $first_result['jibunAddress'],
                'x' => $first_result['longitude'],
                'y' => $first_result['latitude'],
                'formatted_address' => $first_result['formatted_address'],
                'latitude' => $first_result['latitude'],
                'longitude' => $first_result['longitude'],
                'district' => $first_result['district']
            );
            
            error_log('✅ [팝업스토어] 주소 검색 성공');
            wp_send_json_success($response_data);
        } else {
            error_log('❌ [팝업스토어] 주소 검색 실패: ' . ($result['message'] ?? '알 수 없는 오류'));
            wp_send_json_error($result['message'] ?? '검색 결과가 없습니다.');
        }
    }
    
    public function ajax_validate_tour_data() {
        check_ajax_referer('sungsuya_enhanced_admin', 'nonce');
        
        $post_id = intval($_POST['post_id'] ?? 0);
        
        if (!$post_id) {
            wp_send_json_error('잘못된 포스트 ID입니다.');
        }
        
        $score = $this->calculate_tour_compatibility_score($post_id);
        
        wp_send_json_success(array(
            'score' => $score,
            'status' => $this->get_compatibility_status($score)
        ));
    }
    
    private function calculate_tour_compatibility_score($post_id) {
        $required_fields = array('store_name', 'address', 'category', 'latitude', 'longitude');
        $score = 0;
        
        foreach ($required_fields as $field) {
            $value = get_post_meta($post_id, $field, true);
            if (!empty($value)) {
                $score += 20;
            }
        }
        
        $bonus_fields = array('store_description', 'nearest_subway_station');
        foreach ($bonus_fields as $field) {
            $value = get_post_meta($post_id, $field, true);
            if (!empty($value)) {
                $score += 10;
            }
        }
        
        return min(100, $score);
    }
    
    private function get_compatibility_status($score) {
        if ($score >= 80) {
            return array(
                'class' => 'status-excellent',
                'icon' => '🎉',
                'text' => '투어 플래너 준비 완료!'
            );
        } elseif ($score >= 60) {
            return array(
                'class' => 'status-good',
                'icon' => '✅',
                'text' => '투어 플래너 사용 가능'
            );
        } elseif ($score >= 40) {
            return array(
                'class' => 'status-warning',
                'icon' => '⚠️',
                'text' => '일부 정보 추가 필요'
            );
        } else {
            return array(
                'class' => 'status-error',
                'icon' => '❌',
                'text' => '필수 정보 입력 필요'
            );
        }
    }
    
    /**
     * 🚇 AJAX: 혁신적 팝업스토어 관리시스템용 지하철역 자동 검색
     * Places 시스템의 개선된 출구 추천 시스템을 활용
     */
    public function ajax_find_nearest_subway_enhanced() {
        // nonce 검증
        if (!wp_verify_nonce($_POST['nonce'], 'sungsuya_enhanced_admin')) {
            wp_send_json_error('보안 검증에 실패했습니다.');
            return;
        }
        
        $latitude = floatval($_POST['latitude']);
        $longitude = floatval($_POST['longitude']);
        
        if (empty($latitude) || empty($longitude)) {
            wp_send_json_error('좌표 정보가 필요합니다.');
            return;
        }
        
        // 지오코딩 매니저 인스턴스 확인
        global $sungsuya_geocoding_manager;
        if (!$sungsuya_geocoding_manager && class_exists('Sungsuya_Geocoding_Manager')) {
            $sungsuya_geocoding_manager = new Sungsuya_Geocoding_Manager();
        }
        
        if (!$sungsuya_geocoding_manager || !method_exists($sungsuya_geocoding_manager, 'find_nearest_subway_for_places')) {
            wp_send_json_error('지하철역 검색 기능을 사용할 수 없습니다.');
            return;
        }
        
        // Places 시스템의 개선된 지하철역 검색 함수 활용
        $subway_info = $sungsuya_geocoding_manager->find_nearest_subway_for_places($latitude, $longitude);
        
        if ($subway_info) {
            // 혁신적 관리자 시스템에서 사용할 수 있는 형태로 변환
            $walking_time_range = '';
            $walking_time_minutes = $subway_info['walking_time'];
            
            // 도보시간을 기존 선택지에 맞게 변환
            if ($walking_time_minutes <= 3) {
                $walking_time_range = '1-3';
            } elseif ($walking_time_minutes <= 7) {
                $walking_time_range = '4-7';
            } elseif ($walking_time_minutes <= 12) {
                $walking_time_range = '8-12';
            } elseif ($walking_time_minutes <= 20) {
                $walking_time_range = '13-20';
            } else {
                $walking_time_range = '20+';
            }
            
            // 역 이름을 기존 시스템의 키로 변환
            $station_key = '';
            switch ($subway_info['station_name']) {
                case '성수역':
                    $station_key = 'seongsu';
                    break;
                case '건대입구역':
                    $station_key = 'konkuk_univ';
                    break;
                case '왕십리역':
                    $station_key = 'wangsimni';
                    break;
                case '뚝섬역':
                    $station_key = 'ttukseom_park';
                    break;
                case '서울숲역':
                    $station_key = 'seoul_forest';
                    break;
                default:
                    // 기본값 (가장 가까운 역이므로 성수역으로 설정)
                    $station_key = 'seongsu';
                    break;
            }
            
            error_log("🚇 [Enhanced Admin] 지하철역 검색 결과: {$subway_info['station_name']} {$subway_info['recommended_exit']} ({$walking_time_minutes}분)");
            
            wp_send_json_success(array(
                'station_name' => $subway_info['station_name'],
                'station_key' => $station_key,
                'line' => $subway_info['line'],
                'recommended_exit' => $subway_info['recommended_exit'],
                'exit_description' => $subway_info['exit_description'],
                'walking_time' => $walking_time_minutes,
                'walking_time_range' => $walking_time_range,
                'distance' => $subway_info['distance'],
                'display_text' => $subway_info['recommended_exit'] 
                    ? "{$subway_info['station_name']} {$subway_info['recommended_exit']} ({$walking_time_minutes}분)"
                    : "{$subway_info['station_name']} ({$walking_time_minutes}분)"
            ));
        } else {
            wp_send_json_error('주변 지하철역을 찾을 수 없습니다.');
        }
    }
}

// 클래스 초기화
new SungsuyaEnhancedAdminMetabox();
