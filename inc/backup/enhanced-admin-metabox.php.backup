<?php
/**
 * 성수야! V2 - 혁신적 관리자 메타박스 시스템 (작업 4-5 완성)
 * 
 * @package SungsuyaV2
 * @version 3.0.0
 */

if (!defined('ABSPATH')) {
    exit;
}

class SungsuyaEnhancedAdminMetabox {
    
    public function __construct() {
        add_action('add_meta_boxes', array($this, 'add_enhanced_metabox'));
        add_action('save_post', array($this, 'save_enhanced_meta_data'));
        add_action('admin_enqueue_scripts', array($this, 'enqueue_admin_assets'));
        add_action('wp_ajax_sungsuya_search_address', array($this, 'ajax_search_address'));
        add_action('wp_ajax_sungsuya_validate_tour_data', array($this, 'ajax_validate_tour_data'));
        add_action('wp_ajax_sungsuya_find_nearest_subway_enhanced', array($this, 'ajax_find_nearest_subway_enhanced')); // 🚇 새로운 지하철역 검색 핸들러
        
        // 기존 메타박스 제거
        add_action('add_meta_boxes', array($this, 'remove_default_metaboxes'), 999);
    }
    
    public function remove_default_metaboxes() {
        // 기존 네이버 향상된 메타박스들 제거
        remove_meta_box('enhanced_store_location', 'popup_store', 'normal');
        remove_meta_box('enhanced_store_details', 'popup_store', 'normal');
        
        // 기존 기본 메타박스들도 제거 (혹시 있을 수 있는)
        remove_meta_box('popup_store_details', 'popup_store', 'normal');
        remove_meta_box('popup_store_location', 'popup_store', 'normal');
        remove_meta_box('popup_store_info', 'popup_store', 'normal');
        remove_meta_box('popup_store_meta', 'popup_store', 'normal');
    }
    
    public function add_enhanced_metabox() {
        add_meta_box(
            'sungsuya-enhanced-metabox',
            '🎨 혁신적 팝업스토어 관리 시스템',
            array($this, 'render_enhanced_metabox'),
            'popup_store',
            'normal',
            'high'
        );
    }
    
    public function enqueue_admin_assets($hook) {
        global $post_type;
        
        if ($post_type !== 'popup_store') {
            return;
        }
        
        $theme_dir = get_template_directory_uri();
        
        // 혁신적 관리자 CSS
        wp_enqueue_style(
            'sungsuya-enhanced-admin-ui',
            $theme_dir . '/assets/css/admin/enhanced-admin-ui.css',
            array(),
            '3.0.0'
        );
        
        // 혁신적 관리자 JavaScript
        wp_enqueue_script(
            'sungsuya-enhanced-admin-js',
            $theme_dir . '/assets/js/admin/enhanced-admin.js',
            array('jquery'),
            '3.0.0',
            true
        );
        
        // 네이버 지도 API (조건부 로드) - Places와 동일한 설정 사용
        $naver_map_client_id = get_option('sungsuya_naver_client_id', '');
        if (!empty($naver_map_client_id)) {
            // 올바른 API 로딩 방식 적용 (성공한 공식 테스트 페이지와 동일)
            wp_enqueue_script(
                'naver-maps-api-enhanced-admin',
                'https://oapi.map.naver.com/openapi/v3/maps.js?ncpKeyId=' . $naver_map_client_id . '&submodules=geocoder&callback=naverMapEnhancedAdminReady',
                array(),
                null,
                false // header에 로드
            );
        }
        
        // JavaScript 설정 전달
        wp_localize_script('sungsuya-enhanced-admin-js', 'sungsuyaEnhancedAdmin', array(
            'ajaxUrl' => admin_url('admin-ajax.php'),
            'nonce' => wp_create_nonce('sungsuya_enhanced_admin'),
            'naverMapClientId' => $naver_map_client_id,
            'tourPlannerUrl' => home_url('/wp-content/themes/sungsuya-v2-theme/hybrid-tour-planner-test.html'),
            'messages' => array(
                'saved' => '저장되었습니다.',
                'error' => '오류가 발생했습니다.',
                'loading' => '처리 중...',
                'required' => '필수 항목입니다.',
                'addressNotFound' => '주소를 찾을 수 없습니다.'
            )
        ));
    }
    
